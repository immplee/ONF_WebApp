{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/i/:tok([A-Za-z0-9_-]{6,64})/manifest.json",
      "destination": "/student-manifest.json"
    },
    {
      "source": "/i/:tok([A-Za-z0-9_-]{6,64})",
      "destination": "/index.html"
    },
    {
      "source": "/i/:tok([A-Za-z0-9_-]{6,64})/",
      "destination": "/index.html"
    },
    {
      "source": "/:slug([a-z0-9]+-s\\d+-e\\d+-[a-z0-9]+)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/teacher/",
      "has": [
        {
          "type": "host",
          "value": "script.ownify.co.kr"
        }
      ],
      "destination": "https://class.ownify.co.kr/teacher/",
      "permanent": false
    },
    {
      "source": "/teacher/:path*",
      "has": [
        {
          "type": "host",
          "value": "script.ownify.co.kr"
        }
      ],
      "destination": "https://class.ownify.co.kr/teacher/:path*",
      "permanent": false
    },
    {
      "source": "/:page(hw\\.html|dict\\.html)",
      "has": [
        {
          "type": "host",
          "value": "script.ownify.co.kr"
        }
      ],
      "destination": "https://class.ownify.co.kr/:page",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "script.ownify.co.kr"
        }
      ],
      "missing": [
        {
          "type": "query",
          "key": "fileId"
        }
      ],
      "destination": "https://class.ownify.co.kr/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    }
  ]
}
